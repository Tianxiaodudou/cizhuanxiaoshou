#!/bin/bash
# czxs 生命周期脚本：start|stop|restart|status
set -u

APP_HOME="${TRIM_APPDEST:-$(cd "$(dirname "$0")/.." && pwd)}"
PKGVAR="${TRIM_PKGVAR:-$APP_HOME/data}"
JRE="$APP_HOME/jre/bin/java"
PID_FILE="$PKGVAR/czxs.pid"
LOG="$PKGVAR/czxs.log"

export CZ_XS_DATA_DIR="$PKGVAR"
export CZ_XS_ADMIN_SOCKET="$APP_HOME/app.sock"
export CZ_XS_GATEWAY_PREFIX="${CZ_XS_GATEWAY_PREFIX:-/app/czxs}"
[ -f "$APP_HOME/etc/api_port" ] && export CZ_XS_API_PORT="$(cat "$APP_HOME/etc/api_port")"

is_running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
  if is_running; then echo "already running ($(cat "$PID_FILE"))"; exit 0; fi
  mkdir -p "$PKGVAR" "$APP_HOME/target"
  [ -x "$JRE" ] || { echo "bundled jre missing: $JRE" >&2; exit 1; }
  nohup "$JRE" -cp "$APP_HOME/lib/*" czxs.MainKt "$APP_HOME" >>"$LOG" 2>&1 &
  echo $! >"$PID_FILE"
  sleep 2
  if is_running; then echo "started ($(cat "$PID_FILE"))"; else echo "start failed, see $LOG" >&2; tail -n 30 "$LOG" >&2; exit 1; fi
}

stop() {
  if ! is_running; then rm -f "$PID_FILE"; echo "not running"; exit 0; fi
  pid="$(cat "$PID_FILE")"
  kill "$pid" 2>/dev/null
  for _ in $(seq 1 20); do is_running || break; sleep 0.5; done
  is_running && kill -9 "$pid" 2>/dev/null
  rm -f "$PID_FILE" "$APP_HOME/target/app.sock"
  echo "stopped"
}

status() {
  if is_running; then echo "running ($(cat "$PID_FILE"))"; exit 0; fi
  echo "stopped"; exit 3
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
