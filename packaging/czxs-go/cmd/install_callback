#!/bin/bash
set -u
APP_HOME="${TRIM_APPDEST:-$(cd "$(dirname "$0")/.." && pwd)}"
ETC="${TRIM_PKGETC:-$APP_HOME/etc}"
mkdir -p "$ETC" "$ETC/../target" 2>/dev/null || true
umask 077
cat > "$ETC/seed.env" <<EOF
wizard_admin_user=${wizard_admin_user:-admin}
wizard_admin_name=${wizard_admin_name:-管理员}
wizard_admin_password=${wizard_admin_password:-}
wizard_merchant=${wizard_merchant:-}
wizard_api_port=${wizard_api_port:-8080}
EOF
chmod 600 "$ETC/seed.env" 2>/dev/null || true
exit 0
